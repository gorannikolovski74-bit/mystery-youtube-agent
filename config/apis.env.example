# Copy to config/apis.env and fill in. apis.env is git-ignored — never commit it.

ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com -> API Keys
ANTHROPIC_MODEL=claude-sonnet-4-6   # model used for ranking + script writing

REDDIT_CLIENT_ID=...                # reddit.com/prefs/apps -> create "script" app
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=mystery-agent/1.0 by u/yourname

YOUTUBE_CLIENT_ID=...               # console.cloud.google.com -> YouTube Data API v3
YOUTUBE_CLIENT_SECRET=...

TELEGRAM_BOT_TOKEN=...              # @BotFather on Telegram
TELEGRAM_CHAT_ID=...               # your chat id

# Stock footage visuals (option B). Set VISUAL_MODE=stock to use real clips
# instead of stickman animation. Get a free Pexels key at pexels.com/api.
VISUAL_MODE=animation               # 'animation' (stickman), 'stock', 'images', or 'higgsfield'
PEXELS_API_KEY=...                  # free, instant: https://www.pexels.com/api/
# STOCK_SOURCE=pixabay              # alternative provider
# PIXABAY_API_KEY=...               # https://pixabay.com/api/docs/

# AI image visuals (option A). VISUAL_MODE=images + Ken Burns motion.
# IMAGE_PROVIDER=pollinations       # 'pollinations' (free, no key) or 'openai'
# IMAGE_MODEL=flux                  # provider-specific model id
# OPENAI_API_KEY=...                # only for IMAGE_PROVIDER=openai

# Higgsfield AI video (option D). VISUAL_MODE=higgsfield — cinematic AI clips.
# HIGGSFIELD_API_KEY=...             # higgsfield.ai -> Settings -> API Keys
# HIGGSFIELD_MODEL=higgsfield-1      # or higgsfield-1-turbo for faster/cheaper
# HIGGSFIELD_ASPECT=16:9
# HIGGSFIELD_POLL_INTERVAL=5         # seconds between status polls
# HIGGSFIELD_TIMEOUT=300             # max seconds to wait per clip

# Kokoro TTS (optional overrides — defaults work if files sit in project root)
KOKORO_MODEL=kokoro-v1.0.onnx      # path to the Kokoro ONNX model file
KOKORO_VOICES=voices.bin           # path to the voices file
KOKORO_VOICE=af_sky                # voice id (try af_sky or am_michael)
KOKORO_SPEED=0.95                  # 1.0 = normal; slightly slower suits mystery
