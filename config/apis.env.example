# Copy to config/apis.env and fill in. apis.env is git-ignored — never commit it.

ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com -> API Keys
ANTHROPIC_MODEL=claude-sonnet-4-6   # model used for ranking + script writing

REDDIT_CLIENT_ID=...                # reddit.com/prefs/apps -> create "script" app
REDDIT_CLIENT_SECRET=...
REDDIT_USER_AGENT=mystery-agent/1.0 by u/yourname

YOUTUBE_CLIENT_ID=...               # console.cloud.google.com -> YouTube Data API v3
YOUTUBE_CLIENT_SECRET=...

TELEGRAM_BOT_TOKEN=...              # @BotFather on Telegram
TELEGRAM_CHAT_ID=...               # your chat id
